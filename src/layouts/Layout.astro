---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { t, localeHtmlLang, localeOgLocale, defaultLocale } from "../i18n";
import type { Locale } from "../i18n";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;

const {
  title,
  description = t(locale, 'site.description'),
  ogImage = "/logo-horizontal.png",
} = Astro.props as Props;

const currentPath = Astro.url.pathname;
const siteName = t(locale, 'site.name');
const fullTitle = `${title} | ${siteName}`;

const canonicalUrl = new URL(currentPath, Astro.site ?? Astro.url).toString();
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo-vertical.png" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={localeOgLocale[locale]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Chaihuo Makers" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Chaihuo Makers" />

    <meta name="theme-color" content="#fbfaf6" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/SmileySans-Oblique.subset.woff2"
      crossorigin
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700;900&family=Noto+Sans+JP:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Caveat:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.add("js-reveal");
    </script>

    <ClientRouter />
    <title>{fullTitle}</title>

    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-brand-black antialiased">
    <a href="#main-content" class="skip-link focus-ring">{t(locale, 'site.skipLink')}</a>
    <Navbar currentPath={currentPath} locale={locale} />

    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      import "preline/preline";
      import { initReveal } from "../scripts/reveal";

      declare global {
        interface Window {
          HSStaticMethods?: {
            autoInit(): void;
          };
        }
      }

      document.addEventListener("astro:page-load", () => {
        if (window.HSStaticMethods) {
          window.HSStaticMethods.autoInit();
        }
        initReveal();
      });
    </script>
  </body>
</html>