---
import { locales, localeLabels, defaultLocale, getLocaleFromUrl, localizePath } from '../i18n';
import { t } from '../i18n/translations';
import type { Locale } from '../i18n';

interface Props {
  id: string;
}
const { id } = Astro.props as Props;
const currentLocale = (Astro.locals?.locale as Locale | undefined) ?? getLocaleFromUrl(Astro.url) ?? defaultLocale;
const currentPath = Astro.url.pathname;

function getBasePath(path: string, locale: Locale): string {
  if (locale === defaultLocale) return path;
  const prefix = `/${locale}`;
  if (path.startsWith(`${prefix}/`)) return path.slice(prefix.length);
  if (path === prefix) return '/';
  return path;
}

const basePath = getBasePath(currentPath, currentLocale);
---

<nav class="lang-switcher" aria-label={t(currentLocale, 'lang.switcher')}>
  <button
    type="button"
    class="lang-switcher-btn"
    id={`${id}-btn`}
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls={`${id}-menu`}
  >
    <svg class="lang-globe" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>
    </svg>
    <span class="lang-current-label">{localeLabels[currentLocale]}</span>
    <svg class="lang-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </button>

  <div id={`${id}-menu`} class="lang-dropdown" role="menu" aria-labelledby={`${id}-btn`} hidden>
    {
      locales.map((locale) => {
        const href = localizePath(locale, basePath);
        const isActive = locale === currentLocale;
        return (
          <a
            href={href}
            role="menuitem"
            class:list={[
              'lang-option',
              { 'lang-option-active': isActive },
            ]}
            aria-current={isActive ? 'true' : undefined}
            data-lang={locale}
          >
            <span class="lang-label">{localeLabels[locale]}</span>
            {isActive && (
              <svg class="lang-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5"/>
              </svg>
            )}
          </a>
        );
      })
    }
  </div>
</nav>

<script>
  function initLangSwitcher() {
    document.querySelectorAll<HTMLElement>('.lang-switcher').forEach((switcher) => {
      const btn = switcher.querySelector<HTMLButtonElement>('.lang-switcher-btn');
      const dropdown = switcher.querySelector<HTMLElement>('.lang-dropdown');
      if (!btn || !dropdown || btn.dataset.switcherReady) return;
      btn.dataset.switcherReady = '1';

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        dropdown.hidden = expanded;
      });

      document.addEventListener('click', (e) => {
        if (!btn.contains(e.target as Node) && !dropdown.contains(e.target as Node)) {
          btn.setAttribute('aria-expanded', 'false');
          dropdown.hidden = true;
        }
      });

      switcher.querySelectorAll('.lang-option').forEach((el) => {
        el.addEventListener('click', () => {
          const lang = el.getAttribute('data-lang');
          if (lang) {
            document.cookie = `chaihuo-lang=${lang}; Path=/; Max-Age=31536000; SameSite=Lax`;
          }
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initLangSwitcher);
</script>

<style>
  .lang-switcher {
    position: relative;
  }

  .lang-switcher-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 2px;
    border-radius: 6px;
    color: var(--c-neutral-8);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .lang-switcher-btn:hover,
  .lang-switcher-btn[aria-expanded="true"] {
    color: var(--c-foreground);
  }

  .lang-globe {
    opacity: 0.7;
  }

  .lang-current-label {
    line-height: 1;
  }

  /* 窄桌面宽度下只留地球图标，把横向空间让给导航项 */
  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .lang-current-label {
      display: none;
    }
  }

  .lang-chevron {
    opacity: 0.5;
    transition: transform 0.15s ease;
  }

  .lang-switcher-btn[aria-expanded="true"] .lang-chevron {
    transform: rotate(180deg);
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    min-width: 180px;
    background: var(--c-background);
    border: 1px solid var(--c-neutral-3);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md-soft);
    padding: 4px;
    z-index: 100;
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--c-foreground);
    text-decoration: none;
    transition: background 0.1s ease;
    cursor: pointer;
  }

  .lang-option:hover {
    background: var(--c-neutral-1);
  }

  .lang-option-active {
    background: var(--c-accent-soft);
  }

  .lang-label {
    flex: 1;
    line-height: 1;
  }

  .lang-check {
    color: var(--c-accent-ink);
    flex-shrink: 0;
  }
</style>
