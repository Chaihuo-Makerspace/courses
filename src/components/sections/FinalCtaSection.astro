---
import { Icon } from 'astro-icon/components';

interface CtaLink {
  label: string;
  href: string;
  external?: boolean;
}

// 全站唯一的页尾 CTA（原 FinalCtaSection 与 ChipCtaSection 合并）。
// K1 的页尾行动区统一用浅青底，红色按钮始终放在浅色面上。
interface Props {
  cta: {
    title: string;
    description: string;
    primary: CtaLink;
    secondary?: CtaLink;
    note?: string;
  };
}

const { cta } = Astro.props as Props;
---

<section class="closing-cta section bg-neutral-1 border-t border-neutral-3">
  <div class="container-page" data-reveal>
    <div class="max-w-2xl">
      <h2 class="heading-section">{cta.title}</h2>
      <p class="mt-4 text-base leading-relaxed text-neutral-8">
        {cta.description}
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href={cta.primary.href}
          target={cta.primary.external ? '_blank' : undefined}
          rel={cta.primary.external ? 'noopener noreferrer' : undefined}
          class="btn btn-primary focus-ring"
        >
          {cta.primary.label}
          <Icon
            name={cta.primary.external ? 'lucide:arrow-up-right' : 'lucide:arrow-right'}
            class="w-4 h-4"
          />
        </a>
        {
          cta.secondary && (
            <a
              href={cta.secondary.href}
              class="btn btn-secondary focus-ring"
            >
              {cta.secondary.label}
            </a>
          )
        }
      </div>

      {
        cta.note && (
          <p class="mt-5 text-sm text-neutral-6">
            {cta.note}
          </p>
        )
      }
    </div>
  </div>
</section>
