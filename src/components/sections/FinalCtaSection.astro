---
import { Icon } from 'astro-icon/components';

interface CtaLink {
  label: string;
  href: string;
  external?: boolean;
}

// 全站唯一的页尾 CTA（原 FinalCtaSection 与 ChipCtaSection 合并）。
// tone="dark" 是该页的深色面；页面中段已有深色面时用 tone="light"。
interface Props {
  cta: {
    title: string;
    description: string;
    primary: CtaLink;
    secondary?: CtaLink;
    note?: string;
  };
  tone?: 'dark' | 'light';
}

const { cta, tone = 'dark' } = Astro.props as Props;
const isDark = tone === 'dark';
---

<section
  class:list={[
    'section',
    isDark ? 'bg-brand-graphite text-white' : 'bg-neutral-1 border-t border-neutral-3',
  ]}
>
  <div class="container-page" data-reveal>
    <div class="max-w-2xl">
      <h2 class="heading-section">{cta.title}</h2>
      <p
        class:list={[
          'mt-4 text-base leading-relaxed',
          isDark ? 'text-white/75' : 'text-neutral-8',
        ]}
      >
        {cta.description}
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href={cta.primary.href}
          target={cta.primary.external ? '_blank' : undefined}
          rel={cta.primary.external ? 'noopener noreferrer' : undefined}
          class="btn btn-primary focus-ring"
        >
          {cta.primary.label}
          <Icon
            name={cta.primary.external ? 'lucide:arrow-up-right' : 'lucide:arrow-right'}
            class="w-4 h-4"
          />
        </a>
        {
          cta.secondary && (
            <a
              href={cta.secondary.href}
              class:list={['btn focus-ring', isDark ? 'btn-ghost' : 'btn-secondary']}
            >
              {cta.secondary.label}
            </a>
          )
        }
      </div>

      {
        cta.note && (
          <p class:list={['mt-5 text-sm', isDark ? 'text-white/55' : 'text-neutral-6']}>
            {cta.note}
          </p>
        )
      }
    </div>
  </div>
</section>
