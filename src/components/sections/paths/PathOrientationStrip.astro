---
import { Icon } from 'astro-icon/components';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;

const steps = [
  {
    label: dt(locale, 'pathOr.moduleRange'),
    detail: dt(locale, 'pathOr.chooseDirection'),
    href: '/courses#module-reference',
    icon: 'lucide:layers',
  },
  {
    label: dt(locale, 'pathOr.determineLevel'),
    detail: dt(locale, 'pathOr.determineLevel'),
    href: '#levels',
    icon: 'lucide:graduation-cap',
  },
  {
    label: dt(locale, 'pathOr.confirmHardware'),
    detail: dt(locale, 'pathOr.confirmHardware'),
    href: '#tracks',
    icon: 'lucide:package',
  },
  {
    label: dt(locale, 'pathOr.formats'),
    detail: dt(locale, 'pathOr.formats'),
    href: '/contact',
    icon: 'lucide:handshake',
  },
];
---

<section class="bg-neutral-1 border-y border-neutral-3">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-7" data-reveal>
    <div class="mb-4 flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between">
      <h2 class="text-xl md:text-2xl font-black text-brand-black">
        {dt(locale, 'pathOr.heading')}
      </h2>
      <p class="text-sm text-brand-black/75">
        {dt(locale, 'pathOr.subheading')}
      </p>
    </div>

    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-neutral-3 border border-neutral-3 rounded-lg overflow-hidden">
      {
        steps.map((step, index) => (
          <li class="bg-background">
            <a
              href={step.href}
              class="focus-ring group flex h-full items-start gap-3 p-4 transition-colors hover:bg-neutral-1"
            >
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand-black text-white">
                <Icon name={step.icon} class="w-4 h-4" />
              </span>
              <span class="min-w-0">
                <span class="block text-[10px] font-mono font-black uppercase tracking-widest text-brand-black/60">
                  Step {index + 1}
                </span>
                <span class="mt-0.5 block text-sm font-black text-brand-black">
                  {step.label}
                </span>
                <span class="mt-1 block text-xs leading-relaxed text-brand-black/75">
                  {step.detail}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>