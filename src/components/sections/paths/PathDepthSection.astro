---
import { Icon } from 'astro-icon/components';
import LevelBadge from '../../LevelBadge.astro';
import SectionHeader from '../../SectionHeader.astro';
import { levels, levelMeta, type LevelId } from '../../../data/modules';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';
import { localizePath } from '../../../i18n';
import { deepTranslate } from '../../../i18n/module-translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const tLevelMeta = Object.fromEntries(
  Object.entries(levelMeta).map(([k, v]) => [k, { label: deepTranslate(v.label, locale), description: deepTranslate(v.description, locale) }])
) as typeof levelMeta;

const depthCopy: Record<LevelId, { title: string; description: string }> = {
  L1: {
    title: dt(locale, 'pathDepth.l1Title'),
    description: dt(locale, 'pathDepth.l1Desc'),
  },
  L2: {
    title: dt(locale, 'pathDepth.l2Title'),
    description: dt(locale, 'pathDepth.l2Desc'),
  },
  L3: {
    title: dt(locale, 'pathDepth.l3Title'),
    description: dt(locale, 'pathDepth.l3Desc'),
  },
};
---

<section id="levels" class="scroll-mt-24 py-16 md:py-24 px-4 sm:px-6 lg:px-8 bg-neutral-1 border-b border-neutral-3">
  <div class="max-w-6xl mx-auto" data-reveal>
    <SectionHeader
      title={dt(locale, 'pathDepth.heading')}
      subtitle={dt(locale, 'pathDepth.subheading')}
    />

    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        levels.map((level, i) => (
          <article
            class="bg-background border border-neutral-3 rounded-lg p-6 shadow-xs"
            data-reveal
            style={`--reveal-delay: ${i * 70}ms`}
          >
            <div class="flex items-center justify-between gap-3">
              <LevelBadge level={level} label={level} size="md" />
              <span class="text-xs font-mono text-brand-black/50">
                {tLevelMeta[level].description}
              </span>
            </div>
            <h3 class="mt-5 text-xl font-black text-brand-black">
              {depthCopy[level].title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-8">
              {depthCopy[level].description}
            </p>
          </article>
        ))
      }
    </div>

    <a
      href={localizePath(locale, '/courses#course-matrix')}
      class="focus-ring mt-8 inline-flex items-center gap-2 text-sm font-bold text-brand-black hover:text-brand-red transition-colors"
    >
      {dt(locale, 'pathDepth.cta')}
      <Icon name="lucide:arrow-right" class="w-4 h-4" />
    </a>
  </div>
</section>