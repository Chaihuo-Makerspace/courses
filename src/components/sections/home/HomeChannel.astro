---
import { Icon } from 'astro-icon/components';
import { homeChannel } from '../../../data/ecosystem';
import { translateEcosystem, chipHref, isExternalHref } from '../../../i18n/chip-translations';
import type { Locale } from '../../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const data = translateEcosystem(homeChannel, locale);
---

<section class="section-tight bg-neutral-1 border-y border-neutral-3">
  <div class="container-page grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-14" data-reveal>
    <div>
      <h2 class="text-lg font-bold text-brand-black">{data.title}</h2>
      <p class="mt-2 text-sm leading-relaxed text-neutral-8">{data.description}</p>
    </div>
    <ul class="grid gap-px overflow-hidden rounded-lg border border-neutral-3 bg-neutral-3 sm:grid-cols-3">
      {
        data.links.map((link) => (
          <li class="bg-background">
            <a
              href={chipHref(locale, link.href)}
              target={isExternalHref(link.href) ? '_blank' : undefined}
              rel={isExternalHref(link.href) ? 'noopener noreferrer' : undefined}
              class="focus-ring group flex h-full items-start justify-between gap-2 p-4 transition-colors hover:bg-neutral-1"
            >
              <span>
                <span class="block text-sm font-semibold text-brand-black group-hover:text-brand-red transition-colors">
                  {link.label}
                </span>
                <span class="mt-0.5 block text-xs text-neutral-6">{link.note}</span>
              </span>
              <Icon
                name={isExternalHref(link.href) ? 'lucide:arrow-up-right' : 'lucide:arrow-right'}
                class="mt-0.5 h-4 w-4 shrink-0 text-neutral-5 group-hover:text-brand-red transition-colors"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
