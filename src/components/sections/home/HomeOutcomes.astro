---
import type { OutcomeItem } from '../../../data/site';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';

interface Props {
  outcomes: OutcomeItem[];
  locale: Locale;
}

const { outcomes, locale } = Astro.props as Props;
---

<section class="section bg-background">
  <div class="container-page" data-reveal>
    <div class="max-w-3xl">
      <h2 class="heading-section text-foreground">{dt(locale, 'home.outcomes.title')}</h2>
      <p class="mt-3 text-base leading-relaxed text-neutral-7">
        {dt(locale, 'home.outcomes.subtitle')}
      </p>
    </div>

    <ul class="mt-8 grid gap-x-10 border-t border-neutral-3 md:mt-10 md:grid-cols-2">
      {
        outcomes.map((o) => (
          <li class="border-b border-neutral-3 py-4">
            <p class="text-base font-semibold text-foreground">{o.label}</p>
            <p class="mt-1 text-sm leading-relaxed text-neutral-8">{o.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
