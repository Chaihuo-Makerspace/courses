---
import type { OutcomeItem } from '../../../data/site';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';

interface Props {
  outcomes: OutcomeItem[];
  locale: Locale;
}

const { outcomes, locale } = Astro.props as Props;
---

<section class="section bg-background">
  <div class="container-page grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14" data-reveal>
    <div>
      <h2 class="heading-section text-brand-black">{dt(locale, 'home.outcomes.title')}</h2>
      <p class="mt-4 text-base leading-relaxed text-neutral-8">
        {dt(locale, 'home.outcomes.subtitle')}
      </p>
    </div>

    <ol class="border-t border-neutral-3">
      {
        outcomes.map((o, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-3 border-b border-neutral-3 py-4">
            <span class="pt-0.5 font-mono text-sm font-semibold text-brand-red">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <p class="text-base font-semibold text-brand-black">{o.label}</p>
              <p class="mt-1 text-sm leading-relaxed text-neutral-8">{o.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
