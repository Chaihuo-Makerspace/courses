---
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
---

<section class="py-12 px-4 sm:px-6 lg:px-8 bg-background">
  <div class="max-w-7xl mx-auto text-center" data-reveal>
    <h2 class="text-2xl font-bold text-brand-black mb-8">{dt(locale, 'partner.title')}</h2>
    <div class="flex flex-wrap items-center justify-center gap-8 opacity-50">
      <slot />
    </div>
  </div>
</section>