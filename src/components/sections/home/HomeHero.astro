---
import { Icon } from 'astro-icon/components';
import CourseMatrix from '../../CourseMatrix.astro';
import type { Module } from '../../../data/modules';
import { ctaLink } from '../../../i18n/helpers';
import { dt } from '../../../i18n/data-translations';
import { t } from '../../../i18n/translations';
import type { Locale } from '../../../i18n';

// 首页 hero：矩阵是主角（相当于产品截图），青色衬底对应 K1 方案。
// 文本元素只有标题、描述、CTA 组。见 docs/DESIGN.md §4.3。
interface Props {
  modules: Module[];
  locale: Locale;
}

const { modules, locale } = Astro.props as Props;
const primary = ctaLink('courses', locale);
const secondary = ctaLink('contact', locale);
---

<section class="bg-background">
  <div class="container-page pt-10 md:pt-12" data-reveal>
    <div class="max-w-4xl">
      <h1
        class="font-display whitespace-pre-line text-[clamp(2.125rem,3.5vw+1rem,3.25rem)] leading-[1.15] tracking-tight text-brand-black"
      >
        {t(locale, 'home.hero.title')}
      </h1>
      <p class="mt-4 max-w-3xl text-base md:text-lg leading-relaxed text-neutral-8">
        {t(locale, 'home.hero.description')}
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={primary.href} class="btn btn-primary focus-ring">
          {primary.label}
          <Icon name="lucide:arrow-right" class="w-4 h-4" />
        </a>
        <a href={secondary.href} class="btn btn-secondary focus-ring">{secondary.label}</a>
      </div>
    </div>
  </div>

  <div class="relative mt-8 md:mt-9">
    <div class="flame-band absolute inset-x-0 bottom-0 top-20" aria-hidden="true"></div>
    <div class="container-page relative pb-8 md:pb-10" data-reveal style="--reveal-delay: 120ms">
      <div class="matrix-card rounded-lg border border-transparent bg-background p-4 shadow-md-soft md:p-5">
        <CourseMatrix modules={modules} locale={locale} variant="compact" />
        <p class="mt-2.5 text-xs text-neutral-6">{dt(locale, 'home.matrix.note')}</p>
      </div>
    </div>
  </div>
</section>
