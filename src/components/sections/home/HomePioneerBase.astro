---
import { Icon } from 'astro-icon/components';
import SectionHeader from '../../SectionHeader.astro';
import { homePioneerBase } from '../../../data/ecosystem';
import { translateEcosystem, chipHref } from '../../../i18n/chip-translations';
import type { Locale } from '../../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const data = translateEcosystem(homePioneerBase, locale);
const cards = [data.pioneer, data.base];
---

<section class="py-20 md:py-24 px-4 sm:px-6 lg:px-8 bg-background">
  <div class="max-w-6xl mx-auto" data-reveal>
    <SectionHeader title={data.section.title} subtitle={data.section.subtitle} />

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {cards.map((card, i) => (
        <a
          href={chipHref(locale, card.cta.href)}
          class="focus-ring group card-hairline flex h-full flex-col p-8 transition-colors hover:border-brand-black/30"
          data-reveal
          style={`--reveal-delay: ${i * 90}ms`}
        >
          <div class="flex items-center justify-between">
            <span
              class:list={[
                'flex items-center justify-center w-12 h-12 rounded-lg',
                i === 0 ? 'bg-brand-yellow text-brand-black' : 'bg-brand-black text-brand-yellow',
              ]}
            >
              <Icon name={card.icon} class="w-6 h-6" />
            </span>
            <span class="text-xs font-mono font-bold tracking-widest uppercase text-neutral-6">
              {card.label}
            </span>
          </div>

          <h3 class="mt-6 text-xl md:text-2xl font-bold text-brand-black leading-snug">
            {card.headline}
          </h3>

          <ul class="mt-5 space-y-2.5">
            {card.points.map((point) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-neutral-8">
                <Icon name="lucide:check" class="w-4 h-4 mt-1 text-brand-red shrink-0" />
                {point}
              </li>
            ))}
          </ul>

          <span class="mt-auto pt-7 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-black group-hover:text-brand-red transition-colors">
            {card.cta.label}
            <Icon
              name="lucide:arrow-right"
              class="w-4 h-4 transition-transform group-hover:translate-x-0.5"
            />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>