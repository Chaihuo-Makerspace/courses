---
import { Icon } from 'astro-icon/components';
import { homeEcosystemMap } from '../../../data/ecosystem';
import { translateEcosystem, chipHref, isExternalHref } from '../../../i18n/chip-translations';
import type { Locale } from '../../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const data = translateEcosystem(homeEcosystemMap, locale);
---

<section class="py-20 md:py-24 px-4 sm:px-6 lg:px-8 bg-neutral-1">
  <div class="max-w-6xl mx-auto" data-reveal>
    <div class="panel-dark noise-overlay rounded-xl p-8 md:p-12 relative overflow-hidden">
      <div class="relative z-10 grid gap-8 lg:grid-cols-[auto_1fr_auto] lg:items-center">
        <div
          class="flex items-center justify-center w-14 h-14 rounded-lg bg-brand-yellow text-brand-black shrink-0"
          aria-hidden="true"
        >
          <Icon name="lucide:map" class="w-7 h-7" />
        </div>

        <div>
          <p class="text-xs font-mono font-semibold tracking-widest uppercase text-brand-yellow mb-2">
            {data.eyebrow}
          </p>
          <h2 class="text-2xl md:text-3xl font-bold text-white leading-tight">{data.title}</h2>
          <p class="mt-3 text-sm md:text-base text-white/70 leading-relaxed">
            {data.description.join('')}
          </p>
        </div>

        <div class="flex flex-col sm:flex-row lg:flex-col gap-3">
          {data.ctas.map((cta) => (
            <a
              href={chipHref(locale, cta.href)}
              target={isExternalHref(cta.href) ? '_blank' : undefined}
              rel={isExternalHref(cta.href) ? 'noopener noreferrer' : undefined}
              class:list={[
                'focus-ring inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold transition-colors',
                cta.variant === 'primary'
                  ? 'bg-brand-red text-white hover:bg-brand-red-hover'
                  : 'border border-white/30 text-white hover:bg-white/10',
              ]}
            >
              {cta.label}
              <Icon
                name={isExternalHref(cta.href) ? 'lucide:arrow-up-right' : 'lucide:arrow-right'}
                class="w-4 h-4"
              />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>