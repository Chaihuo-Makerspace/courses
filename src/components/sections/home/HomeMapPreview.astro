---
import { Icon } from 'astro-icon/components';
import SectionHeader from '../../SectionHeader.astro';
import { dt } from '../../../i18n/data-translations';
import { t } from '../../../i18n/translations';
import type { Locale } from '../../../i18n';
import { localizePath } from '../../../i18n';
import type { Module } from '../../../data/modules';

interface Props {
  locale: Locale;
  modules: Module[];
}

interface Props {
  locale: Locale;
}

const { locale, modules } = Astro.props as Props;
---

<section class="py-20 px-4 sm:px-6 lg:px-8 bg-neutral-1">
  <div class="max-w-6xl mx-auto" data-reveal>
    <SectionHeader
      eyebrow={t(locale, 'home.mapPreview.eyebrow')}
      title={dt(locale, 'home.map.title')}
      subtitle={dt(locale, 'home.map.subtitle')}
    />

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.45fr_0.75fr] items-start">
      <ul class="grid gap-4 md:grid-cols-2">
        {modules.map((m) => (
          <li class="bg-background border border-neutral-3 rounded-lg p-5">
            <div class="flex items-start gap-4">
              <span class:list={[
                'module-tile shrink-0',
                m.id === 'm0' ? 'module-tile--red' : 'module-tile--dark',
              ]}>
                {m.code}
              </span>
              <div>
                <p class="text-base font-semibold text-brand-black leading-tight">{m.title}</p>
                <p class="mt-1 text-xs font-mono text-neutral-6">{m.subtitle}</p>
                <p class="mt-2.5 text-sm leading-relaxed text-neutral-8">{m.oneLiner}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>

      <div class="bg-background border border-neutral-3 rounded-lg p-6">
        <div class="flex items-center gap-2 text-xs font-mono font-semibold tracking-widest uppercase text-neutral-7 mb-5">
          <Icon name="lucide:graduation-cap" class="w-4 h-4 text-brand-red" />
          {t(locale, 'hero.levels')}
        </div>

        <ul class="space-y-4">
          <li>
            <p class="text-sm font-semibold text-brand-black">{dt(locale, 'level.l1.label')}</p>
            <p class="mt-1 text-sm leading-relaxed text-neutral-7">{dt(locale, 'level.l1.desc')}</p>
          </li>
          <li>
            <p class="text-sm font-semibold text-brand-black">{dt(locale, 'level.l2.label')}</p>
            <p class="mt-1 text-sm leading-relaxed text-neutral-7">{dt(locale, 'level.l2.desc')}</p>
          </li>
          <li>
            <p class="text-sm font-semibold text-brand-black">{dt(locale, 'level.l3.label')}</p>
            <p class="mt-1 text-sm leading-relaxed text-neutral-7">{dt(locale, 'level.l3.desc')}</p>
          </li>
        </ul>

        <p class="mt-6 text-xs leading-relaxed text-neutral-6">{dt(locale, 'mapLegend.note')}</p>

        <a
          href={localizePath(locale, '/courses')}
          class="focus-ring inline-flex items-center gap-2 mt-6 text-sm font-semibold text-brand-black hover:text-brand-red transition-colors"
        >
          {dt(locale, 'home.map.cta')}
          <Icon name="lucide:arrow-right" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</section>