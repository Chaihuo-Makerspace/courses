---
import PartnershipCard from '../../PartnershipCard.astro';
import SectionHeader from '../../SectionHeader.astro';
import type { PartnershipForm } from '../../../data/partnerships';
import { dt } from '../../../i18n/data-translations';
import { t } from '../../../i18n/translations';
import type { Locale } from '../../../i18n';

interface Props {
  partnershipForms: PartnershipForm[];
  locale: Locale;
}

const { partnershipForms, locale } = Astro.props as Props;
---

<section class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 bg-neutral-1 border-t border-b border-neutral-3">
  <div class="max-w-7xl mx-auto" data-reveal>
    <SectionHeader
      title={dt(locale, 'section.formsTitle')}
      subtitle={dt(locale, 'section.formsSubtitle')}
    />
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
      {partnershipForms.map((f) => <PartnershipCard form={f} locale={locale} />)}
    </div>

    <div
      id="partnership-qr"
      class="scroll-mt-24 mt-10 grid gap-6 md:grid-cols-[auto_1fr] items-center panel-dark noise-overlay p-6 md:p-8"
    >
      <img
        src="/qr-partnership.png"
        alt={t(locale, 'contact.forms.qrAlt')}
        width="290"
        height="290"
        class="w-36 h-36 md:w-44 md:h-44 border border-white/15 rounded-lg bg-white p-2"
        loading="eager"
      />
      <div>
        <p class="text-xs font-mono font-bold uppercase tracking-widest text-brand-yellow mb-2">
          {t(locale, 'contact.forms.eyebrow')}
        </p>
        <h3 class="text-2xl md:text-3xl font-black leading-tight">
          {t(locale, 'contact.cta.primary')}
        </h3>
        <p class="mt-3 text-sm md:text-base text-white/70 leading-relaxed max-w-2xl">
          {t(locale, 'contact.cta.description')}
        </p>

        <p class="mt-6 text-sm font-semibold text-white">
          {dt(locale, 'contact.interest.heading')}
        </p>
        <div class="mt-2.5 flex flex-wrap gap-2">
          {['o1', 'o2', 'o3'].map((key) => (
            <span class="rounded-full border border-white/25 px-3 py-1.5 text-xs text-white/80">
              {dt(locale, `contact.interest.${key}`)}
            </span>
          ))}
        </div>
        <p class="mt-3 text-xs leading-relaxed text-white/50 max-w-2xl">
          {dt(locale, 'contact.interest.note')}
        </p>
      </div>
    </div>
  </div>
</section>