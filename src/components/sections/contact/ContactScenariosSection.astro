---
import ScenarioCard from '../../ScenarioCard.astro';
import SectionHeader from '../../SectionHeader.astro';
import type { Scenario } from '../../../data/partnerships';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';

interface Props {
  scenarios: Scenario[];
  locale: Locale;
}

const { scenarios, locale } = Astro.props as Props;
---

<section class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 bg-background">
  <div class="max-w-7xl mx-auto" data-reveal>
    <SectionHeader
      title={dt(locale, 'section.scenariosTitle')}
      subtitle={dt(locale, 'section.scenariosSubtitle')}
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
      {scenarios.map((s, i) => <ScenarioCard scenario={s} delayMs={i * 70} locale={locale} />)}
    </div>
  </div>
</section>