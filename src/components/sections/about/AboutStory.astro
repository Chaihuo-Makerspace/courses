---
// /about 的正文只有一样东西：具名负责人和他对这门课的看法。
interface Props {
  person: { name: string; role: string; quote: string };
}

const { person } = Astro.props as Props;
---

<section class="section bg-background">
  <div class="container-page" data-reveal>
    <figure class="max-w-3xl border-l-2 border-primary pl-6 md:pl-8">
      <blockquote class="text-xl font-semibold leading-relaxed text-foreground md:text-2xl md:leading-relaxed">
        {person.quote}
      </blockquote>
      <figcaption class="mt-6 text-sm leading-relaxed">
        <span class="block font-bold text-foreground">{person.name}</span>
        <span class="block text-neutral-7">{person.role}</span>
      </figcaption>
    </figure>
  </div>
</section>
