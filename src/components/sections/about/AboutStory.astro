---
import { Icon } from 'astro-icon/components';
import SectionHeader from '../../SectionHeader.astro';
import type { HistoryItem } from '../../../data/site';
import { t } from '../../../i18n/translations';
import type { Locale } from '../../../i18n';

// /about 的正文：来历按先后排成一条线（空间 → 硬件 → 课程），再加一位具名负责人。
interface Props {
  history: HistoryItem[];
  person: { name: string; role: string; quote: string };
  locale: Locale;
}

const { history, person, locale } = Astro.props as Props;
---

<section class="section bg-background">
  <div class="container-page" data-reveal>
    <SectionHeader title={t(locale, 'about.history.title')} />

    <ol class="grid md:grid-cols-3">
      {
        history.map((item, i) => (
          <li class="relative border-l border-neutral-3 pb-10 pl-6 last:pb-0 md:border-l-0 md:pb-0 md:border-t md:pl-0 md:pr-10 md:pt-7">
            <span
              class="absolute -left-[5px] top-1.5 h-2.5 w-2.5 rounded-full bg-primary md:-top-[5px] md:left-0"
              aria-hidden="true"
            />
            <div class="flex items-center gap-3">
              <span class="font-display text-2xl leading-tight text-primary-ink">{item.when}</span>
              {i < history.length - 1 && (
                <Icon
                  name="lucide:arrow-right"
                  class="hidden h-4 w-4 text-neutral-5 md:block"
                  aria-hidden="true"
                />
              )}
            </div>
            <h3 class="mt-3 text-base font-bold leading-snug text-foreground">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-8">{item.description}</p>
            {item.link && (
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="focus-ring mt-3 inline-flex items-center gap-1 text-sm font-semibold text-foreground transition-colors hover:text-primary-ink"
              >
                {item.link.replace(/^https?:\/\/(www\.)?/, '')}
                <Icon name="lucide:arrow-up-right" class="h-3.5 w-3.5" />
              </a>
            )}
          </li>
        ))
      }
    </ol>

    <figure class="mt-12 max-w-3xl border-l-2 border-primary pl-6 md:mt-16">
      <blockquote class="text-lg font-semibold leading-relaxed text-foreground">
        {person.quote}
      </blockquote>
      <figcaption class="mt-5 text-sm leading-relaxed">
        <span class="block font-bold text-foreground">{person.name}</span>
        <span class="block text-neutral-7">{person.role}</span>
      </figcaption>
    </figure>
  </div>
</section>
