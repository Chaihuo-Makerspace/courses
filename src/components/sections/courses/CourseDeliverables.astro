---
import { Icon } from 'astro-icon/components';
import type { Module } from '../../../data/modules';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';

interface Props {
  module: Module;
  locale: Locale;
}

const { module, locale } = Astro.props as Props;
---

<section class="py-14 md:py-20 px-4 sm:px-6 lg:px-8 bg-brand-black text-white noise-overlay">
  <div class="max-w-6xl mx-auto" data-reveal>
    <div class="flex items-center gap-3 mb-6">
      <Icon name="lucide:package" class="w-6 h-6 text-brand-yellow" />
    </div>
    <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight">
      {module.deliverableCards ? dt(locale, 'course.deliverablesTitleM0') : dt(locale, 'course.deliverablesTitle')}
    </h2>
    <p class="mt-3 text-sm md:text-base text-white/70 max-w-3xl leading-relaxed">
      {module.deliverablesIntro ?? dt(locale, 'course.deliverablesIntro')}
    </p>

    {module.deliverableCards ? (
      <ul class="mt-10 grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-white/10 border border-white/15 rounded-lg overflow-hidden">
        {module.deliverableCards.map((d, i) => (
          <li class="bg-brand-black p-5">
            <span class="text-xs font-mono font-bold text-brand-yellow">
              {String(i + 1).padStart(2, '0')}
            </span>
            <b class="mt-2 block text-sm font-bold text-white leading-snug">{d.title}</b>
            <p class="mt-1.5 text-xs text-white/70 leading-relaxed">{d.body}</p>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="mt-10 grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-white/10 border border-white/15 rounded-lg overflow-hidden">
        {module.deliverables.map((d) => (
          <li class="bg-brand-black p-5 flex items-start gap-3">
            <Icon name="lucide:check" class="w-5 h-5 text-brand-yellow shrink-0 mt-0.5" />
            <span class="text-sm font-bold text-white leading-relaxed">{d}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>