---
import { Icon } from 'astro-icon/components';
import SectionHeader from '../../SectionHeader.astro';
import type { Module } from '../../../data/modules';
import type { Track } from '../../../data/tracks';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';
import { localizePath } from '../../../i18n';

// 全站唯一的「三个方向」渲染，同时是模块列表：方向即分组。
// 锚点 #track-<id> 供外链与课程详情页回链使用。
interface Props {
  tracks: Track[];
  modules: Module[];
  locale: Locale;
}

const { tracks, modules, locale } = Astro.props as Props;
const byId = (id: string) => modules.find((m) => m.id === id);
---

<section id="learning-tracks" class="section scroll-mt-24 bg-background">
  <div class="container-page" data-reveal>
    <SectionHeader
      title={dt(locale, 'course.tracksTitle')}
      subtitle={dt(locale, 'course.tracksSubtitle')}
    />

    <div class="space-y-10">
      {
        tracks.map((track) => (
          <div
            id={`track-${track.id}`}
            class="scroll-mt-24 grid gap-5 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14"
          >
            <div>
              <h3 class="text-xl font-bold text-brand-black">{track.name}</h3>
              <p class="mt-1 text-sm font-semibold text-brand-red">{track.goal}</p>
              <p class="mt-3 text-sm leading-relaxed text-neutral-8">{track.description}</p>
            </div>

            <ul class="border-t border-neutral-3">
              {track.moduleIds.map((id) => {
                const m = byId(id);
                if (!m) return null;
                return (
                  <li class="border-b border-neutral-3">
                    <a
                      href={localizePath(locale, `/courses/${m.slug}`)}
                      class="focus-ring group flex items-start gap-4 py-4 transition-colors hover:bg-neutral-1"
                    >
                      <span
                        class:list={[
                          'module-tile shrink-0',
                          m.id === 'm0' ? 'module-tile--red' : 'module-tile--dark',
                        ]}
                      >
                        {m.code}
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                          <span class="text-base font-bold text-brand-black transition-colors group-hover:text-brand-red">
                            {m.title}
                          </span>
                          {m.overseasOnly && (
                            <span class="rounded-sm border border-brand-red/40 px-1.5 py-0.5 text-[11px] font-semibold leading-none text-brand-red">
                              {dt(locale, 'course.overseasOnly')}
                            </span>
                          )}
                        </span>
                        <span class="mt-1 block text-sm leading-relaxed text-neutral-8">
                          {m.subtitle}
                        </span>
                        <span class="mt-1 block text-xs text-neutral-6">{m.duration}</span>
                      </span>
                      <Icon
                        name="lucide:arrow-right"
                        class="mt-1 h-4 w-4 shrink-0 text-neutral-5 transition-colors group-hover:text-brand-red"
                      />
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
