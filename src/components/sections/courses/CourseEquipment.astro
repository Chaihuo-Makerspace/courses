---
import { Icon } from 'astro-icon/components';
import SectionHeader from '../../SectionHeader.astro';
import type { Module } from '../../../data/modules';
import { dt } from '../../../i18n/data-translations';
import { t } from '../../../i18n/translations';
import type { Locale } from '../../../i18n';

// 设备与工具链：核心硬件清单和工具链常显；带图的逐件设备清单默认折叠（渐进分层）。
interface Props {
  module: Module;
  locale: Locale;
}

const { module, locale } = Astro.props as Props;
const toolchain = module.toolchain;
const intro = module.hardwareIntro;
const kits = module.kits;

// 每个模块讲自己的工具链：`course.toolchain{Title,Subtitle}.<id>`；M0 用不带后缀的基础 key。
const orBase = (key: string, baseKey: string) => {
  const value = dt(locale, key);
  return value === key ? dt(locale, baseKey) : value;
};
const toolchainTitle = orBase(`course.toolchainTitle.${module.id}`, 'course.toolchainTitle');
const toolchainSubtitle = orBase(
  `course.toolchainSubtitle.${module.id}`,
  'course.toolchainSubtitle',
);
const subtitle = intro?.subtitle ?? (kits ? dt(locale, 'course.kitsSubtitle') : undefined);
const photoCount = intro ? intro.items.length : (kits?.items.length ?? 0);
---

<section id="equipment" class="section scroll-mt-28 bg-background">
  <div class="container-page" data-reveal>
    <SectionHeader title={t(locale, 'course.equipmentTitle')} subtitle={subtitle} />

    {
      module.hardwareList && (
        <ul class="grid gap-x-10 border-t border-neutral-3 sm:grid-cols-2">
          {module.hardwareList.map((hw) => (
            <li class="flex gap-3 border-b border-neutral-3 py-3">
              <span class="w-16 shrink-0 pt-0.5 font-mono text-xs font-semibold text-neutral-6">
                {hw.key}
              </span>
              <span>
                <span class="block text-sm font-bold text-foreground">{hw.name}</span>
                <span class="mt-0.5 block text-xs leading-relaxed text-neutral-7">{hw.note}</span>
              </span>
            </li>
          ))}
        </ul>
      )
    }

    {
      photoCount > 0 && (
        <details class="group mt-5">
          <summary class="focus-ring inline-flex cursor-pointer list-none items-center gap-2 text-sm font-semibold text-foreground hover:text-primary-ink transition-colors [&::-webkit-details-marker]:hidden">
            <Icon name="lucide:chevron-right" class="h-4 w-4 transition-transform group-open:rotate-90" />
            {t(locale, kits ? 'course.kitsDetails' : 'course.hardwareDetails', { n: String(photoCount) })}
          </summary>

          <ul class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {(intro?.items ?? []).map((item) => (
              <li class="card-hairline flex flex-col overflow-hidden">
                {/* 产品图自带白底，衬底用白墨才不露边 —— */}
                <div class="aspect-[4/3] w-full overflow-hidden border-b border-neutral-3 bg-brand-white">
                  <img
                    src={item.image}
                    alt={item.imageAlt}
                    width="1200"
                    height="900"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain"
                  />
                </div>
                <div class="p-4">
                  <h3 class="text-sm font-bold text-foreground">{item.name}</h3>
                  <p class="mt-1 text-xs font-semibold text-primary-ink">{item.note}</p>
                  <p class="mt-2 text-sm leading-relaxed text-neutral-8">{item.description}</p>
                </div>
              </li>
            ))}
            {(kits?.items ?? []).map((kit) => (
              <li class="card-hairline flex flex-col overflow-hidden">
                <div class="aspect-[4/3] w-full overflow-hidden border-b border-neutral-3 bg-brand-white">
                  <img
                    src={kit.image}
                    alt={kit.imageAlt}
                    width="1200"
                    height="900"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-contain"
                  />
                </div>
                <div class="p-4">
                  <p class="font-mono text-xs font-semibold text-primary-ink">{kit.code}</p>
                  <h3 class="mt-1 text-sm font-bold text-foreground">{kit.title}</h3>
                  <p class="mt-0.5 text-xs font-semibold text-neutral-7">{kit.hardware}</p>
                  <p class="mt-2 text-sm leading-relaxed text-neutral-8">{kit.body}</p>
                </div>
              </li>
            ))}
          </ul>
          {intro?.note && (
            <p class="mt-4 max-w-3xl text-sm leading-relaxed text-neutral-7">{intro.note}</p>
          )}
          {kits && (
            <p class="mt-4 max-w-3xl text-sm leading-relaxed text-neutral-7">
              <span class="font-semibold text-foreground">{kits.pool.title}</span>
              <span class="mx-1.5 text-neutral-5" aria-hidden="true">·</span>
              {kits.pool.body}
            </p>
          )}
        </details>
      )
    }

    {
      toolchain && (
        <div class="mt-10 border-t border-neutral-3 pt-8">
          <h3 class="text-xl font-bold text-foreground">{toolchainTitle}</h3>
          <p class="mt-2 max-w-3xl text-sm leading-relaxed text-neutral-7">
            {toolchainSubtitle}
          </p>

          <ol
            class:list={[
              'mt-6 grid gap-px overflow-hidden rounded-lg border border-neutral-3 bg-neutral-3',
              toolchain.stages.length >= 3 ? 'lg:grid-cols-3' : 'md:grid-cols-2',
            ]}
          >
            {toolchain.stages.map((stage) => (
              <li class:list={['p-5', stage.highlight ? 'bg-accent-soft' : 'bg-background']}>
                <h4 class="text-base font-bold text-foreground">{stage.name}</h4>
                <p class="mt-1 text-xs text-neutral-7">{stage.meta}</p>
                <ol class="mt-4 flex flex-wrap items-center gap-x-1.5 gap-y-2 text-sm font-semibold text-foreground">
                  {stage.steps.map((step, j) => (
                    <li class="inline-flex items-center gap-1.5">
                      {j > 0 && (
                        <Icon name="lucide:arrow-right" class="h-3.5 w-3.5 text-neutral-5" aria-hidden="true" />
                      )}
                      {step}
                    </li>
                  ))}
                </ol>
              </li>
            ))}
          </ol>

          <p class="mt-4 max-w-3xl border-l-2 border-primary pl-4 text-sm leading-relaxed text-neutral-8">
            <span class="font-semibold text-foreground">{toolchain.hinge.title}</span>
            <span class="mx-1.5 text-neutral-5" aria-hidden="true">·</span>
            {toolchain.hinge.body}
          </p>
          {toolchain.note && (
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-neutral-7">{toolchain.note}</p>
          )}
        </div>
      )
    }
  </div>
</section>
