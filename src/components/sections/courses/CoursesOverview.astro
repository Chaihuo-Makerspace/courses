---
import CourseMatrix from '../../CourseMatrix.astro';
import type { Module } from '../../../data/modules';
import { dt } from '../../../i18n/data-translations';
import { t } from '../../../i18n/translations';
import type { Locale } from '../../../i18n';

// /courses 首屏：页面标题直接接完整矩阵，不再隔一个 hero。
interface Props {
  modules: Module[];
  locale: Locale;
}

const { modules, locale } = Astro.props as Props;
---

<section id="course-matrix" class="scroll-mt-24 bg-background">
  <div class="container-page pt-12 pb-12 md:pt-16 md:pb-16" data-reveal>
    <div class="max-w-3xl">
      <h1
        class="font-display text-[clamp(2.25rem,4vw+1rem,3.5rem)] leading-[1.15] tracking-tight text-brand-black"
      >
        {t(locale, 'courses.title')}
      </h1>
      <p class="mt-5 text-base md:text-lg leading-relaxed text-neutral-8">
        {t(locale, 'courses.description')}
      </p>
    </div>

    <div class="mt-8 md:mt-10">
      <CourseMatrix modules={modules} locale={locale} />
      <p class="mt-3 text-xs text-neutral-6 md:hidden">{dt(locale, 'courseMatrix.swipeHint')}</p>
    </div>
  </div>
  <div class="flame-rule" aria-hidden="true"></div>
</section>
