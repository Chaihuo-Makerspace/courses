---
import type { Module } from '../../../data/modules';
import { t } from '../../../i18n/translations';
import type { Locale } from '../../../i18n';

// 上课现场的真实照片。没有照片的模块不渲染这一段。
interface Props {
  module: Module;
  locale: Locale;
}

const { module, locale } = Astro.props as Props;
const photos = module.fieldPhotos ?? [];
---

{
  photos.length > 0 && (
    <section class="section bg-background">
      <div class="container-page" data-reveal>
        <h2 class="heading-section text-foreground">{t(locale, 'course.fieldTitle')}</h2>
        <ul class="mt-8 grid gap-6 md:grid-cols-2">
          {photos.map((photo) => (
            <li>
              <figure>
                <div class="aspect-[4/3] overflow-hidden rounded-lg border border-neutral-3 bg-neutral-1">
                  <img
                    src={photo.src}
                    alt={photo.caption}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </div>
                <figcaption class="mt-3 text-sm leading-relaxed text-neutral-7">
                  {photo.caption}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
