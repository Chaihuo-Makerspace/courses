---
import SectionHeader from '../../SectionHeader.astro';
import TrackFlow from '../../TrackFlow.astro';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';
import { tracks } from '../../../data/tracks';
import { modules } from '../../../data/modules';
import { translateTracks, translateModules } from '../../../i18n/helpers';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const translatedTracks = translateTracks(tracks, locale);
const translatedModules = translateModules(modules, locale);
---

<section id="learning-tracks" class="py-14 md:py-20 px-4 sm:px-6 lg:px-8 bg-background">
  <div class="max-w-7xl mx-auto" data-reveal>
    <SectionHeader
      title={dt(locale, 'course.tracksTitle')}
      subtitle={dt(locale, 'course.tracksSubtitle')}
    />
    <div class="panel-light p-2 sm:p-4 border border-neutral-3 rounded-lg">
      <TrackFlow locale={locale} tracks={translatedTracks} modules={translatedModules} />
    </div>
  </div>
</section>