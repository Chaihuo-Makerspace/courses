---
import { Icon } from 'astro-icon/components';
import LevelBadge from '../../LevelBadge.astro';
import SectionHeader from '../../SectionHeader.astro';
import { levels, levelMeta, type LevelId, type Module } from '../../../data/modules';
import { dt } from '../../../i18n/data-translations';
import { deepTranslate } from '../../../i18n/module-translations';
import type { Locale } from '../../../i18n';

// 学完能做什么。M1–M6：L1 / L2 / L3 三档各学到哪一步 + 能力清单；
// M0 按硬件平台分层，这里用它的能力卡长文（三套平台在「设备与工具链」里）。
interface Props {
  module: Module;
  locale: Locale;
}

const { module, locale } = Astro.props as Props;
const cards = module.capabilityCards;

const cellBg: Record<LevelId, string> = {
  L1: 'bg-level-1',
  L2: 'bg-level-2',
  L3: 'bg-level-3',
};
const levelName = (lvl: LevelId) => deepTranslate(levelMeta[lvl].label, locale).split(' · ')[1];
const days = (n: number) => `${n} ${dt(locale, n === 1 ? 'course.day' : 'course.days')}`;
---

<section id="levels" class="section scroll-mt-28 bg-background border-b border-neutral-3">
  <div class="container-page" data-reveal>
    {
      cards ? (
        <>
          <SectionHeader
            title={dt(locale, 'course.capabilitiesTitle')}
            subtitle={dt(locale, 'course.capabilitiesSubtitle')}
          />
          <ul class="grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
            {cards.map((cap, i) => (
              <li class="border-t border-neutral-3 py-5">
                <span class="font-mono text-sm font-semibold text-primary-ink">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-1.5 text-base font-bold text-foreground">{cap.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-neutral-8">{cap.body}</p>
              </li>
            ))}
          </ul>
          {module.capabilityCallout && (
            <p class="mt-4 max-w-3xl border-l-2 border-primary pl-4 text-sm leading-relaxed text-neutral-8">
              {module.capabilityCallout}
            </p>
          )}
        </>
      ) : (
        <>
          <SectionHeader title={dt(locale, 'course.ladderTitle')} />
          <ol class="grid gap-0.5 md:grid-cols-3">
            {levels.map((lvl) => {
              const cell = module.cells[lvl];
              return (
                <li class:list={['p-5 md:p-6', cellBg[lvl]]}>
                  <div class="flex items-center justify-between gap-2">
                    <span class="flex items-center gap-2">
                      <LevelBadge level={lvl} label={lvl} />
                      <span class="text-sm font-semibold text-foreground">{levelName(lvl)}</span>
                    </span>
                    <span class="text-sm font-semibold text-foreground/70">
                      {days(cell.durationDays)}
                    </span>
                  </div>
                  <h3 class="mt-5 text-xl font-bold leading-tight text-foreground">{cell.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-foreground/75">{cell.subtitle}</p>
                  <ul class="mt-4 space-y-2 border-t border-foreground/10 pt-4 text-sm leading-relaxed text-foreground/85">
                    {cell.outcomes.map((o) => (
                      <li class="flex items-start gap-2">
                        <Icon name="lucide:check" class="mt-1 h-3.5 w-3.5 shrink-0 text-primary-ink" />
                        <span>{o}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              );
            })}
          </ol>

          <h3 class="label mt-8">{dt(locale, 'course.keyCapabilities')}</h3>
          <ul class="mt-3 grid gap-x-10 border-t border-neutral-3 sm:grid-cols-2">
            {module.capabilities.map((c) => (
              <li class="border-b border-neutral-3 py-2.5 text-sm font-medium text-foreground">
                {c}
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</section>
