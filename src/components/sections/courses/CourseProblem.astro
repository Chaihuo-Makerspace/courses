---
import type { Module } from '../../../data/modules';
import { dt } from '../../../i18n/data-translations';
import { t } from '../../../i18n/translations';
import type { Locale } from '../../../i18n';

// 这门课解决什么问题、给谁学、用在哪。
interface Props {
  module: Module;
  locale: Locale;
}

const { module, locale } = Astro.props as Props;
---

<section class="section bg-background">
  <div class="container-page grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14" data-reveal>
    <div>
      <h2 class="heading-section text-brand-black">{dt(locale, 'course.whatProblem')}</h2>
      <p class="mt-4 text-base leading-relaxed text-neutral-8">{module.realProblem}</p>

      <dl class="mt-6 space-y-3 text-sm leading-relaxed">
        <div>
          <dt class="label">{dt(locale, 'course.audienceTitle')}</dt>
          <dd class="mt-1 text-neutral-8">{module.audience.join(' · ')}</dd>
        </div>
        {
          module.prerequisite && (
            <div>
              <dt class="label">{t(locale, 'course.prerequisite')}</dt>
              <dd class="mt-1 text-neutral-8">{module.prerequisite}</dd>
            </div>
          )
        }
      </dl>
    </div>

    <div>
      <h3 class="label">{dt(locale, 'course.typicalScenarios')}</h3>
      <ul class="mt-3 border-t border-neutral-3">
        {
          module.scenarios.map((s) => (
            <li class="border-b border-neutral-3 py-2.5 text-sm leading-relaxed text-neutral-8">
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
