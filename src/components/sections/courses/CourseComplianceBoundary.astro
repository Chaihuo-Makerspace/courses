---
import { Icon } from 'astro-icon/components';
import type { Module } from '../../../data/modules';
import type { Locale } from '../../../i18n';
import { t } from '../../../i18n';

// 能力边界与合规约束：全文保留。「不交付 / 不承诺」写清楚，是买家最看重的信任信息。
interface Props {
  module: Module;
  locale: Locale;
}

const { module, locale } = Astro.props as Props;
const boundary = module.complianceBoundary;
---

{
  boundary && (
    <section id="boundary" class="section scroll-mt-28 bg-neutral-1 border-y border-neutral-3">
      <div class="container-page" data-reveal>
        <header class="max-w-3xl mb-8">
          <h2 class="heading-section text-foreground">{t(locale, 'course.complianceBoundary')}</h2>
          {boundary.principles?.map((p) => (
            <p class="mt-4 text-lg font-semibold leading-relaxed text-foreground">{p}</p>
          ))}
        </header>

        <div class="grid gap-x-14 gap-y-8 md:grid-cols-2">
          <div>
            <h3 class="text-base font-bold text-foreground">
              {t(locale, 'course.compliance.applicable')}
            </h3>
            <ul class="mt-3 border-t border-neutral-3">
              {boundary.applicable.map((item) => (
                <li class="flex gap-3 border-b border-neutral-3 py-2.5 text-sm leading-relaxed text-neutral-8">
                  <Icon name="lucide:check" class="mt-1 h-4 w-4 shrink-0 text-neutral-7" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="text-base font-bold text-primary-ink">
              {t(locale, 'course.compliance.notApplicable')}
            </h3>
            <ul class="mt-3 border-t border-neutral-3">
              {boundary.notApplicable.map((item) => (
                <li class="flex gap-3 border-b border-neutral-3 py-2.5 text-sm leading-relaxed text-neutral-8">
                  <Icon name="lucide:x" class="mt-1 h-4 w-4 shrink-0 text-primary-ink" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  )
}
