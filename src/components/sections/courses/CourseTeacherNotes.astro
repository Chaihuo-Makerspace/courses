---
import type { Module } from '../../../data/modules';
import type { Locale } from '../../../i18n';

// 「写给老师」：全文保留 —— 这是全站最有区分度的内容。
interface Props {
  module: Module;
  locale: Locale;
}

const { module } = Astro.props as Props;
const notes = module.teacherNotes;

// heading 拆成「前 / 强调 / 后」；emphasis 不是子串时整句原样渲染。
const at = notes?.emphasis ? notes.heading.indexOf(notes.emphasis) : -1;
const parts =
  notes?.emphasis && at >= 0
    ? {
        before: notes.heading.slice(0, at),
        mark: notes.emphasis,
        after: notes.heading.slice(at + notes.emphasis.length),
      }
    : null;
---

{
  notes && (
    <section id="teachers" class="section scroll-mt-28 bg-background">
      <div class="container-page" data-reveal>
        <header class="max-w-3xl">
          <h2 class="heading-section text-foreground">
            {parts ? (
              <>
                {parts.before}<em class="highlight">{parts.mark}</em>{parts.after}
              </>
            ) : (
              notes.heading
            )}
          </h2>
          <p class="mt-4 text-base leading-relaxed text-neutral-8">{notes.intro}</p>
        </header>

        <ul class="mt-8 grid gap-x-10 md:grid-cols-3">
          {notes.openings.map((o) => (
            <li class="border-t border-neutral-3 py-5">
              <p class="text-sm font-semibold text-primary-ink">{o.no}</p>
              <h3 class="mt-1 text-lg font-bold text-foreground">{o.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-8">{o.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
