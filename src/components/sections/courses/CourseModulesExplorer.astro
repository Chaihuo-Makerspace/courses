---
import { Icon } from 'astro-icon/components';
import ModuleCard from '../../ModuleCard.astro';
import ModuleOneLiner from '../../ModuleOneLiner.astro';
import type { Module } from '../../../data/modules';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';

interface Props {
  modules: Module[];
  locale: Locale;
}

const { modules, locale } = Astro.props as Props;
---

<section id="module-reference" class="scroll-mt-24 py-12 md:py-16 px-4 sm:px-6 lg:px-8 bg-background border-t border-brand-black/10">
  <div class="max-w-6xl mx-auto" data-reveal>
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8">
      <div>
        <h2 class="text-2xl md:text-3xl font-black text-brand-black">
          {dt(locale, 'course.explorerTitle')}
        </h2>
        <p class="mt-3 text-sm md:text-base text-neutral-7 max-w-2xl">
          {dt(locale, 'course.explorerSubtitle')}
        </p>
      </div>

      <div class="inline-flex bg-background border border-neutral-3 p-1 rounded-lg shrink-0 self-start md:self-auto select-none shadow-xs z-10">
        <button
          id="btn-card-view"
          type="button"
          class="focus-ring px-4 py-2 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 text-neutral-6 hover:text-brand-black cursor-pointer"
          aria-controls="wrapper-card-view"
          aria-pressed="false"
          aria-label="{dt(locale, 'course.explorer.switchCard')}"
        >
          <Icon name="lucide:layers" class="w-3.5 h-3.5" />
          {dt(locale, 'course.explorer.cardView')}
        </button>
        <button
          id="btn-list-view"
          type="button"
          class="focus-ring px-4 py-2 text-xs font-bold rounded-lg transition-colors flex items-center gap-1.5 bg-brand-black text-white cursor-pointer"
          aria-controls="wrapper-list-view"
          aria-pressed="true"
          aria-label="{dt(locale, 'course.explorer.switchList')}"
        >
          <Icon name="lucide:menu" class="w-3.5 h-3.5" />
          {dt(locale, 'course.explorer.listView')}
        </button>
      </div>
    </div>

    <div id="wrapper-card-view" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 transition-all duration-300" hidden>
      {modules.map((m) => <ModuleCard module={m} locale={locale} />)}
    </div>

    <div id="wrapper-list-view" class="space-y-3 transition-all duration-300">
      {modules.map((m) => <ModuleOneLiner module={m} locale={locale} />)}
    </div>
  </div>
</section>
