---
import { Icon } from 'astro-icon/components';
import type { Module } from '../../../data/modules';

interface Props {
  module: Module;
}

const { module } = Astro.props as Props;

// On-palette difficulty coding (no off-palette green): 入门 灰 · 进阶 黄 · 高级 红
const difficultyDot: Record<string, string> = {
  入门: 'bg-neutral-5',
  进阶: 'bg-brand-yellow',
  高级: 'bg-brand-red',
};
const diffDotClass = difficultyDot[module.difficulty] ?? 'bg-neutral-5';
---

<section class="py-10 md:py-12 px-4 sm:px-6 lg:px-8 bg-background border-b border-neutral-3">
  <div class="max-w-6xl mx-auto" data-reveal>
    <div class="border-l-4 border-brand-red bg-brand-yellow-light/60 px-4 py-3 max-w-2xl rounded-r-lg">
      <p class="text-xs font-mono font-bold uppercase tracking-widest text-brand-red mb-1">这个模块解决什么</p>
      <p class="text-sm leading-relaxed text-brand-black">{module.realProblem}</p>
    </div>

    {/* facts 就位时用速览条取代默认 chip 行——两者信息重叠，不并存。 */}
    {module.facts ? (
      <dl class="mt-6 flex flex-wrap border border-neutral-3 rounded-lg bg-card overflow-hidden max-w-2xl">
        {module.facts.map((fact, i) => (
          <div
            class:list={[
              'flex-1 min-w-32 px-4 py-3',
              i > 0 && 'border-l border-neutral-3',
            ]}
          >
            <dt class="text-[10px] font-mono font-bold uppercase tracking-widest text-neutral-6">
              {fact.label}
            </dt>
            <dd class="mt-1 text-sm font-bold text-brand-black leading-tight">{fact.value}</dd>
          </div>
        ))}
      </dl>
    ) : (
      <div class="mt-6 flex flex-wrap gap-3 text-xs font-mono font-bold">
        <span class="inline-flex items-center gap-2 bg-card border border-neutral-3 px-3.5 py-2 rounded-lg shadow-xs text-brand-black">
          <span class:list={['w-2 h-2 rounded-full shrink-0', diffDotClass]} aria-hidden="true"></span>
          难度 {module.difficulty}
        </span>
        <span class="inline-flex items-center gap-1.5 bg-card border border-neutral-3 px-3.5 py-2 rounded-lg shadow-xs text-brand-black">
          <Icon name="lucide:clock" class="w-4 h-4 text-brand-red" />
          {module.duration}
        </span>
        <span class="inline-flex items-center gap-1.5 bg-card border border-neutral-3 px-3.5 py-2 rounded-lg shadow-xs text-brand-black">
          <Icon name="lucide:users" class="w-4 h-4 text-brand-red" />
          {module.audience.length} 类受众群体
        </span>
      </div>
    )}

    {module.prerequisite && (
      <p class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-black/70">
        <Icon name="lucide:route" class="w-4 h-4 text-brand-red" />
        {module.prerequisite}
      </p>
    )}

    <div class="mt-6">
      <p class="text-xs font-mono font-bold uppercase tracking-widest text-brand-black/55 mb-2">典型应用场景</p>
      <div class="flex flex-wrap gap-2">
        {module.scenarios.map((s) => (
          <span class="inline-flex items-center rounded-full bg-brand-yellow-light border border-brand-black/15 px-3 py-1 text-xs font-semibold text-brand-black">
            {s}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
