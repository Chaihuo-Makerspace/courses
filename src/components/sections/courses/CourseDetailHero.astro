---
import { Icon } from 'astro-icon/components';
import type { Module } from '../../../data/modules';
import { dt } from '../../../i18n/data-translations';
import { t } from '../../../i18n/translations';
import type { Locale } from '../../../i18n';
import { localizePath } from '../../../i18n';

interface Props {
  module: Module;
  totalDays: number;
  locale: Locale;
}

const { module, locale } = Astro.props as Props;
const isM0 = module.id === 'm0';
const illoBg = isM0 ? 'bg-brand-yellow/15' : 'bg-brand-yellow-light';

// oneLiner 的黄色下划线强调：拆成「前 / 强调 / 后」三段。
// emphasis 缺席或不是 oneLiner 子串时整句原样渲染。
const emphasisAt = module.oneLinerEmphasis
  ? module.oneLiner.indexOf(module.oneLinerEmphasis)
  : -1;
const oneLinerParts =
  module.oneLinerEmphasis && emphasisAt >= 0
    ? {
        before: module.oneLiner.slice(0, emphasisAt),
        mark: module.oneLinerEmphasis,
        after: module.oneLiner.slice(emphasisAt + module.oneLinerEmphasis.length),
      }
    : null;
---

<section class="bg-neutral-1 border-b border-neutral-3 py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
    <a
      href={localizePath(locale, '/courses')}
      class="focus-ring inline-flex items-center gap-1.5 text-sm font-semibold text-brand-black hover:text-brand-red transition-colors mb-8"
      aria-label={dt(locale, 'course.backToMatrix')}
    >
      <Icon name="lucide:arrow-left" class="w-4 h-4" />
      {dt(locale, 'course.backToMatrix')}
    </a>

    <div class="grid lg:grid-cols-[1.3fr_1fr] gap-12 lg:gap-16 items-center">
      <div>
        <div class="flex items-center gap-3.5 mb-6">
          <span class:list={[
            'module-tile module-tile--lg font-mono',
            isM0 ? 'module-tile--red' : 'module-tile--dark',
          ]}>
            {module.code}
          </span>
          <span class="text-sm font-bold tracking-widest uppercase text-brand-black/60 font-mono">
            {module.subtitle}
          </span>
        </div>

        <h1 class="text-[clamp(2.25rem,4vw+1rem,3.75rem)] font-black leading-tight text-brand-black tracking-tight">
          {module.title}
        </h1>
        <p class="mt-6 text-lg md:text-xl leading-relaxed text-neutral-8 max-w-2xl">
          {oneLinerParts ? (
            <>
              {oneLinerParts.before}
              <em class="not-italic font-bold text-brand-black bg-linear-to-b from-transparent from-60% to-brand-yellow to-60%">
                {oneLinerParts.mark}
              </em>
              {oneLinerParts.after}
            </>
          ) : (
            module.oneLiner
          )}
        </p>
      </div>

      <div>
        <div
          class:list={[
            'aspect-[4/3] w-full max-w-md mx-auto rounded-lg flex items-center justify-center overflow-hidden border border-neutral-3 relative shadow-sm-soft z-10',
            illoBg,
          ]}
        >
          <img
            src={module.illustration}
            alt={`${module.title} ${t(locale, 'course.illustration')}`}
            width="1024"
            height="768"
            class="w-full h-full object-cover relative z-10"
            loading="eager"
            fetchpriority="high"
            onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden')"
          />
          <div class="absolute inset-0 hidden flex flex-col items-center justify-center text-center p-4 bg-brand-black/5 z-0">
            <Icon name="lucide:cpu" class="w-12 h-12 mb-2 text-brand-black opacity-30" />
            <span class="text-4xl font-mono font-black tracking-wider text-brand-black opacity-30">
              {module.code}
            </span>
            <span class="text-[10px] font-mono tracking-widest text-brand-black opacity-45 uppercase mt-1">
              WORKBENCH IMAGE
            </span>
          </div>
        </div>

        {module.hardwareList && (
          <div class="mt-5 max-w-md mx-auto border border-neutral-3 rounded-lg bg-card p-5">
            <h2 class="text-[10px] font-mono font-bold uppercase tracking-widest text-neutral-6">
              {t(locale, 'course.coreHardwareHeading')}
            </h2>
            <ul class="mt-3.5">
              {module.hardwareList.map((hw) => (
                <li class="flex gap-3 py-2 border-b border-dashed border-neutral-3 last:border-b-0">
                  <span class="font-mono text-xs text-neutral-6 pt-0.5 min-w-4 shrink-0">
                    {hw.key}
                  </span>
                  <span>
                    <b class="block text-sm font-bold text-brand-black">{hw.name}</b>
                    <small class="block text-xs text-neutral-6 mt-0.5">{hw.note}</small>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
