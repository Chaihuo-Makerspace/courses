---
import { Icon } from 'astro-icon/components';
import type { Module } from '../../../data/modules';
import type { Track } from '../../../data/tracks';
import { dt } from '../../../i18n/data-translations';
import { ctaLink } from '../../../i18n/helpers';
import { t } from '../../../i18n/translations';
import type { Locale } from '../../../i18n';
import { localizePath } from '../../../i18n';

// 首屏回答「值不值得引入」：这门课是什么、解决什么问题、几天、给谁学、用在哪。
interface Props {
  module: Module;
  tracks: Track[];
  locale: Locale;
}

const { module, tracks, locale } = Astro.props as Props;
const contact = ctaLink('contact', locale);

// oneLiner 的强调片段：拆成「前 / 强调 / 后」。emphasis 不是子串时整句原样渲染。
const at = module.oneLinerEmphasis ? module.oneLiner.indexOf(module.oneLinerEmphasis) : -1;
const parts =
  module.oneLinerEmphasis && at >= 0
    ? {
        before: module.oneLiner.slice(0, at),
        mark: module.oneLinerEmphasis,
        after: module.oneLiner.slice(at + module.oneLinerEmphasis.length),
      }
    : null;
---

<section class="bg-background">
  <div class="container-page pt-8 pb-10 md:pt-10 md:pb-12">
    <a
      href={localizePath(locale, '/courses')}
      class="focus-ring inline-flex items-center gap-1.5 text-sm font-semibold text-neutral-7 hover:text-primary-ink transition-colors"
    >
      <Icon name="lucide:arrow-left" class="w-4 h-4" />
      {dt(locale, 'course.backToMatrix')}
    </a>

    <div class="mt-6 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
      <div data-reveal>
        <div class="flex flex-wrap items-center gap-3">
          <span
            class:list={[
              'module-tile module-tile--lg font-mono',
              module.id === 'm0' ? 'module-tile--red' : 'module-tile--dark',
            ]}
          >
            {module.code}
          </span>
          {
            module.overseasOnly && (
              <span class="rounded-sm border border-primary/40 px-2 py-1 text-xs font-semibold leading-none text-primary-ink">
                {dt(locale, 'course.overseasOnly')}
              </span>
            )
          }
        </div>

        <h1
          class="mt-5 font-display text-[clamp(2.25rem,4vw+1rem,3.5rem)] leading-[1.15] tracking-tight text-foreground"
        >
          {module.title}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-neutral-8">
          {
            parts ? (
              <>
                {parts.before}<em class="highlight font-semibold text-foreground">{parts.mark}</em>{parts.after}
              </>
            ) : (
              module.oneLiner
            )
          }
        </p>
        <p class="mt-4 text-base leading-relaxed text-neutral-7">{module.realProblem}</p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a href={contact.href} class="btn btn-primary focus-ring">
            {contact.label}
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
          </a>
        </div>
      </div>

      <dl class="self-start border-t border-neutral-3" data-reveal style="--reveal-delay: 120ms">
        {
          module.facts?.map((fact) => (
            <div class="grid grid-cols-[6.5rem_1fr] gap-x-4 border-b border-neutral-3 py-2.5">
              <dt class="label pt-0.5">{fact.label}</dt>
              <dd class="text-sm font-semibold leading-snug text-foreground">{fact.value}</dd>
            </div>
          ))
        }
        {
          tracks.map((track) => (
            <div class="grid grid-cols-[6.5rem_1fr] gap-x-4 border-b border-neutral-3 py-2.5">
              <dt class="label pt-0.5">{t(locale, 'course.direction')}</dt>
              <dd class="text-sm font-semibold leading-snug">
                <a
                  href={localizePath(locale, `/courses#track-${track.id}`)}
                  class="focus-ring text-foreground underline decoration-neutral-4 underline-offset-4 hover:text-primary-ink hover:decoration-primary-ink transition-colors"
                >
                  {track.name}
                </a>
              </dd>
            </div>
          ))
        }
        <div class="grid grid-cols-[6.5rem_1fr] gap-x-4 border-b border-neutral-3 py-2.5">
          <dt class="label pt-0.5">{dt(locale, 'course.audienceTitle')}</dt>
          <dd class="text-sm leading-relaxed text-neutral-8">{module.audience.join(' · ')}</dd>
        </div>
        {
          module.prerequisite && (
            <div class="grid grid-cols-[6.5rem_1fr] gap-x-4 border-b border-neutral-3 py-2.5">
              <dt class="label pt-0.5">{t(locale, 'course.prerequisite')}</dt>
              <dd class="text-sm leading-relaxed text-neutral-8">{module.prerequisite}</dd>
            </div>
          )
        }
      </dl>
    </div>

    <div class="mt-10" data-reveal>
      <h2 class="label">{dt(locale, 'course.typicalScenarios')}</h2>
      <ul class="mt-3 grid gap-x-10 border-t border-neutral-3 sm:grid-cols-2">
        {
          module.scenarios.map((s) => (
            <li class="border-b border-neutral-3 py-2.5 text-sm leading-relaxed text-neutral-8">{s}</li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
