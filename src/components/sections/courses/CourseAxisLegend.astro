---
import SectionHeader from '../../SectionHeader.astro';
import { homeMapLegend } from '../../../data/site';
import { dt } from '../../../i18n/data-translations';
import type { Locale } from '../../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props as Props;
const note = homeMapLegend.note;
---

<section class="py-12 md:py-16 px-4 sm:px-6 lg:px-8 bg-brand-graphite noise-overlay border-b border-white/10">
  <div class="max-w-6xl mx-auto" data-reveal>
    <SectionHeader
      title={dt(locale, 'courseAxis.title')}
      subtitle={dt(locale, 'courseAxis.subtitle')}
      tone="dark"
    />

    <div class="mt-10 grid md:grid-cols-2 gap-6">
      <div class="border border-white/10 rounded-lg p-6 bg-white/5">
        <p class="text-xs font-mono font-bold uppercase tracking-widest text-brand-yellow mb-3">{dt(locale, 'mapLegend.axisX.label')}</p>
        <p class="text-sm leading-relaxed text-white/85">{dt(locale, 'mapLegend.axisX.desc')}</p>
        <ul class="mt-4 space-y-2">
          <li class="flex items-center gap-2 text-sm text-white/70">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-yellow shrink-0"></span>
            M0 · {dt(locale, 'mapLegend.anchorM0')}
          </li>
          <li class="flex items-center gap-2 text-sm text-white/70">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-yellow shrink-0"></span>
            M1–M5 · {dt(locale, 'mapLegend.anchorM1M5')}
          </li>
        </ul>
      </div>
      <div class="border border-white/10 rounded-lg p-6 bg-white/5">
        <p class="text-xs font-mono font-bold uppercase tracking-widest text-brand-yellow mb-3">{dt(locale, 'mapLegend.axisY.label')}</p>
        <p class="text-sm leading-relaxed text-white/85">{dt(locale, 'mapLegend.axisY.desc')}</p>
        <ul class="mt-4 space-y-2">
          <li class="flex items-baseline gap-3"><span class="font-black text-brand-yellow w-14 shrink-0">L1</span><span class="text-white/85">{dt(locale, 'courseAxis.l1')}</span></li>
          <li class="flex items-baseline gap-3"><span class="font-black text-brand-yellow w-14 shrink-0">L2</span><span class="text-white/85">{dt(locale, 'courseAxis.l2')}</span></li>
          <li class="flex items-baseline gap-3"><span class="font-black text-brand-yellow w-14 shrink-0">L3</span><span class="text-white/85">{dt(locale, 'courseAxis.l3')}</span></li>
        </ul>
      </div>
    </div>
    {note && (
      <p class="mt-6 text-sm text-white/50 text-center">{dt(locale, 'mapLegend.note')}</p>
    )}
  </div>
</section>