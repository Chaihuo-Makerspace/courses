---
import { Icon } from 'astro-icon/components';
import type { IconName } from '../data/icons';

interface CTA {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
  icon?: IconName;
}

// 内页 hero：文本元素 ≤3（标题、描述、CTA 组）。首页用 HomeHero。
interface Props {
  id?: string;
  title: string;
  description?: string;
  ctas?: CTA[];
}

const { id, title, description, ctas = [] } = Astro.props as Props;

const hasTitleSlot = Astro.slots.has('title');
---

<section id={id} class="scroll-mt-24 bg-background">
  <div class="container-page pt-12 pb-10 md:pt-16 md:pb-12">
    <div class="max-w-3xl" data-reveal>
      <h1
        class="font-display text-[clamp(2.25rem,4vw+1rem,3.5rem)] leading-[1.15] tracking-tight text-foreground"
      >
        {hasTitleSlot ? <slot name="title" /> : title}
      </h1>

      {
        description && (
          <p class="mt-5 text-base md:text-lg leading-relaxed text-neutral-8">{description}</p>
        )
      }

      {
        ctas.length > 0 && (
          <div class="mt-7 flex flex-wrap gap-3">
            {ctas.map((cta) => (
              <a
                href={cta.href}
                target={cta.external ? '_blank' : undefined}
                rel={cta.external ? 'noopener noreferrer' : undefined}
                class:list={[
                  'btn focus-ring',
                  cta.variant === 'secondary' ? 'btn-secondary' : 'btn-primary',
                ]}
              >
                {cta.label}
                <Icon
                  name={
                    cta.icon ?? (cta.external ? 'lucide:arrow-up-right' : 'lucide:arrow-right')
                  }
                  class="w-4 h-4"
                />
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
  <div class="flame-rule" aria-hidden="true"></div>
</section>
