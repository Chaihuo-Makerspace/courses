---
import type { Module } from '../data/modules';
import type { Locale } from '../i18n';
import { localizePath } from '../i18n';

interface Props {
  module: Module;
  locale?: Locale;
}

const { module, locale } = Astro.props as Props;
const tileClass =
  module.accent === 'red' ? 'module-tile--red' : 'module-tile--dark';
---

<a
  href={localizePath(locale ?? 'zh-CN', `/courses/${module.slug}`)}
  class="group card-hairline focus-ring flex items-center gap-4 px-5 py-4 md:px-6 md:py-5 bg-background"
>
  <span class:list={['module-tile', tileClass]}>{module.code}</span>
  <div class="flex-1 min-w-0">
    <div class="flex items-baseline gap-3">
      <h3 class="font-bold text-base md:text-lg leading-tight truncate text-brand-black">
        {module.title}
      </h3>
      <span class="text-xs text-neutral-6 hidden md:inline">
        {module.subtitle}
      </span>
    </div>
    <p class="text-sm mt-1 text-neutral-7 leading-snug">{module.oneLiner}</p>
  </div>
</a>
