---
import LevelBadge from './LevelBadge.astro';
import { levels, levelMeta, type LevelId, type Module } from '../data/modules';
import { dt } from '../i18n/data-translations';
import type { Locale } from '../i18n';
import { localizePath } from '../i18n';
import { deepTranslate } from '../i18n/module-translations';

// 全站唯一的 M × L 矩阵，也是 L1 / L2 / L3 的唯一图例（列头）。
// full：/courses 的完整矩阵（每格带副题与产出）；compact：首页 hero（每格只有标题与天数）。
interface Props {
  locale: Locale;
  modules: Module[];
  variant?: 'full' | 'compact';
}

const { locale, modules, variant = 'full' } = Astro.props as Props;
const isFull = variant === 'full';

const level = (lvl: LevelId) => {
  const [, name] = deepTranslate(levelMeta[lvl].label, locale).split(' · ');
  return { name, description: deepTranslate(levelMeta[lvl].description, locale) };
};

// 深度越深、黄色越浓：L1 淡黄 → L2 中黄 → L3 亮黄。
const cellBg: Record<LevelId, string> = {
  L1: 'bg-brand-yellow-light',
  L2: 'bg-brand-yellow-mid',
  L3: 'bg-level-l3',
};
---

<div class:list={['overflow-x-auto', isFull && '-mx-4 px-4 md:mx-0 md:px-0']}>
  <table
    class:list={[
      'w-full border-separate text-left',
      isFull ? 'min-w-[720px] border-spacing-1' : 'border-spacing-x-1 border-spacing-y-1',
    ]}
  >
    <caption class="sr-only">{dt(locale, 'courseMatrix.srCaption')}</caption>
    <thead>
      <tr>
        <th scope="col" class:list={[isFull ? 'w-[190px]' : 'w-auto']}>
          <span class="sr-only">{dt(locale, 'courseMatrix.srHeader')}</span>
        </th>
        {
          levels.map((lvl) => (
            <th
              scope="col"
              class:list={['align-bottom font-normal', isFull ? 'p-3 pb-2' : 'px-2 pb-1.5 md:px-3']}
            >
              <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                <LevelBadge level={lvl} label={lvl} />
                <span
                  class:list={[
                    'text-sm font-semibold text-brand-black',
                    !isFull && 'hidden md:inline',
                  ]}
                >
                  {level(lvl).name}
                </span>
              </div>
              {
                isFull && (
                  <p class="mt-1.5 text-xs leading-snug text-neutral-7">{level(lvl).description}</p>
                )
              }
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        modules.map((m) => (
          <tr>
            <th scope="row" class:list={['font-normal align-top', isFull ? 'p-0' : 'pr-2']}>
              <a
                href={localizePath(locale, `/courses/${m.slug}`)}
                class:list={[
                  'focus-ring group flex rounded-md',
                  isFull ? 'h-full flex-col gap-2 p-3 hover:bg-neutral-1' : 'items-center gap-3 py-0.5',
                ]}
              >
                <span
                  class:list={[
                    'module-tile module-tile--sm shrink-0',
                    m.id === 'm0' ? 'module-tile--red' : 'module-tile--dark',
                  ]}
                >
                  {m.code}
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold leading-tight text-brand-black transition-colors group-hover:text-brand-red">
                    {m.title}
                  </span>
                  {m.overseasOnly && (
                    <span class="mt-1 inline-block rounded-sm border border-brand-red/40 px-1.5 py-0.5 text-[11px] font-semibold leading-none text-brand-red">
                      {dt(locale, 'course.overseasOnly')}
                    </span>
                  )}
                  {isFull && m.id === 'm0' && (
                    <span class="mt-1 block text-xs text-neutral-6">
                      {dt(locale, 'courseMatrix.platformLayers')}
                    </span>
                  )}
                </span>
              </a>
            </th>
            {levels.map((lvl) => {
              const cell = m.cells[lvl];
              return (
                <td class:list={['rounded-sm align-top', cellBg[lvl], isFull ? 'p-3' : 'px-2 py-1.5 md:px-3']}>
                  <div class="flex items-start justify-between gap-2">
                    <span
                      class:list={[
                        'font-semibold leading-tight text-brand-black',
                        isFull ? 'text-sm' : 'hidden text-[13px] md:block',
                      ]}
                    >
                      {cell.title}
                    </span>
                    <span class="shrink-0 font-mono text-xs font-semibold text-brand-black/70">
                      {cell.durationDays}d
                    </span>
                  </div>
                  {isFull && (
                    <>
                      <p class="mt-1.5 text-xs leading-snug text-brand-black/70">{cell.subtitle}</p>
                      <ul class="mt-2 space-y-0.5 text-xs leading-snug text-brand-black/85">
                        {cell.outcomes.slice(0, 2).map((o) => (
                          <li>· {o}</li>
                        ))}
                      </ul>
                    </>
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
