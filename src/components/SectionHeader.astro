---
interface Props {
  title: string;
  subtitle?: string;
  as?: 'h2' | 'h3';
  tone?: 'light' | 'dark';
}

const { title, subtitle, as: Heading = 'h2', tone = 'light' } = Astro.props as Props;

const isDark = tone === 'dark';
---

<header class="max-w-3xl mb-8 md:mb-10">
  <Heading class:list={['heading-section', isDark ? 'text-white' : 'text-brand-black']}>
    {title}
  </Heading>
  {
    subtitle && (
      <p
        class:list={[
          'mt-3 text-base leading-relaxed',
          isDark ? 'text-white/70' : 'text-neutral-7',
        ]}
      >
        {subtitle}
      </p>
    )
  }
</header>
