---
import type { Module } from '~/data/modules';
import { t } from '../i18n/translations';
import type { Locale } from '../i18n';
import { localizePath } from '../i18n';

interface Props {
  modules: Module[];
  locale: Locale;
}

const { modules, locale } = Astro.props as Props;
---

<div class="card-hairline p-5 md:p-6">
  <div class="flex items-center justify-between mb-4">
    <p class="text-xs font-mono font-semibold uppercase tracking-widest text-neutral-7">
      {t(locale, 'hero.courseMap')}
    </p>
    <span class="text-[11px] font-mono text-neutral-6">{t(locale, 'hero.levels')}</span>
  </div>

  <ul class="grid gap-2.5">
    {
      modules.map((m) => (
        <li>
          <a
            href={localizePath(locale, `/courses/${m.slug}`)}
            class="focus-ring flex items-center gap-3 group"
          >
            <span
              class:list={[
                'module-tile module-tile--sm shrink-0',
                m.id === 'm0' ? 'module-tile--red' : 'module-tile--dark',
              ]}
            >
              {m.code}
            </span>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-brand-black leading-tight truncate group-hover:text-brand-red transition-colors">
                {m.title}
              </p>
              <p class="text-[11px] font-mono text-neutral-6 truncate">{m.subtitle}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</div>