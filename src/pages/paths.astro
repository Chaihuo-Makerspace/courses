---
import HeroBanner from '../components/HeroBanner.astro';
import Layout from '../layouts/Layout.astro';
import FinalCtaSection from '../components/sections/FinalCtaSection.astro';
import PathDepthSection from '../components/sections/paths/PathDepthSection.astro';
import PathOrientationStrip from '../components/sections/paths/PathOrientationStrip.astro';
import PathTracksSection from '../components/sections/paths/PathTracksSection.astro';
import { pathsFinalCta } from '../data/site';
import { tracks } from '../data/tracks';
import { t, defaultLocale, localizePath } from '../i18n';
import type { Locale } from '../i18n';
import { translateTracks, translateCta, translateModules } from '../i18n/helpers';
import { modules } from '../data/modules';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const translatedTracks = translateTracks(tracks, locale);
const translatedCta = translateCta(pathsFinalCta, locale);
const translatedModules = translateModules(modules, locale);
---

<Layout title={t(locale, 'paths.title')}>
  <HeroBanner
    eyebrow={t(locale, 'paths.title')}
    title={t(locale, 'paths.title')}
    description={t(locale, 'paths.description')}
    ctas={[
      { label: t(locale, 'paths.cta.primary'), href: '#tracks', variant: 'primary' },
      { label: t(locale, 'paths.cta.secondary'), href: localizePath(locale, '/courses'), variant: 'secondary' },
    ]}
  />

  <PathOrientationStrip locale={locale} />
  <PathDepthSection locale={locale} />
  <PathTracksSection tracks={translatedTracks} locale={locale} modules={translatedModules} />
  <FinalCtaSection cta={translatedCta} bordered headingSize="xl" />
</Layout>