---
import Layout from '../../layouts/Layout.astro';
import FinalCtaSection from '../../components/sections/FinalCtaSection.astro';
import CourseDirections from '../../components/sections/courses/CourseDirections.astro';
import CoursesOverview from '../../components/sections/courses/CoursesOverview.astro';
import { modules } from '../../data/modules';
import { coursesFinalCta } from '../../data/site';
import { tracks } from '../../data/tracks';
import { t, defaultLocale } from '../../i18n';
import type { Locale } from '../../i18n';
import { translateCta, translateModules, translateTracks } from '../../i18n/helpers';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const translatedModules = translateModules(modules, locale);
---

<Layout title={t(locale, 'courses.title')}>
  <CoursesOverview modules={translatedModules} locale={locale} />
  <CourseDirections
    tracks={translateTracks(tracks, locale)}
    modules={translatedModules}
    locale={locale}
  />
  <FinalCtaSection cta={translateCta(coursesFinalCta, locale)} />
</Layout>
