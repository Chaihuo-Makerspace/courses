---
import Layout from '../layouts/Layout.astro';
import { ctaLink } from '../i18n/helpers';
import { t, defaultLocale, localizePath } from '../i18n';
import type { Locale } from '../i18n';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const courses = ctaLink('courses', locale);
---

<Layout title={t(locale, '404.title')}>
  <section class="bg-background">
    <div class="container-page py-20 md:py-28">
      <p class="font-display text-7xl leading-none text-brand-red">{t(locale, '404.heading')}</p>
      <h1 class="heading-section mt-6 text-brand-black">{t(locale, '404.message')}</h1>
      <p class="mt-3 max-w-md text-base leading-relaxed text-neutral-8">
        {t(locale, '404.submessage')}
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={courses.href} class="btn btn-primary focus-ring">{courses.label}</a>
        <a href={localizePath(locale, '/')} class="btn btn-secondary focus-ring">
          {t(locale, '404.backHome')}
        </a>
      </div>
    </div>
  </section>
</Layout>
