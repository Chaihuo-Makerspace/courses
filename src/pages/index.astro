---
import Layout from '../layouts/Layout.astro';
import FinalCtaSection from '../components/sections/FinalCtaSection.astro';
import HomeChannel from '../components/sections/home/HomeChannel.astro';
import HomeHero from '../components/sections/home/HomeHero.astro';
import HomeOutcomes from '../components/sections/home/HomeOutcomes.astro';
import { modules } from '../data/modules';
import { homeFinalCta, homeOutcomes } from '../data/site';
import { t, defaultLocale } from '../i18n';
import type { Locale } from '../i18n';
import { translateCta, translateModules, translateOutcomes } from '../i18n/helpers';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
---

<Layout title={t(locale, 'nav.home')}>
  <HomeHero modules={translateModules(modules, locale)} locale={locale} />
  <HomeOutcomes outcomes={translateOutcomes(homeOutcomes, locale)} locale={locale} />
  <HomeChannel locale={locale} />
  <FinalCtaSection cta={translateCta(homeFinalCta, locale)} />
</Layout>
