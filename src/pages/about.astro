---
import HeroBanner from '../components/HeroBanner.astro';
import Layout from '../layouts/Layout.astro';
import AboutStory from '../components/sections/about/AboutStory.astro';
import FinalCtaSection from '../components/sections/FinalCtaSection.astro';
import { aboutFinalCta, aboutFacts } from '../data/site';
import { t, defaultLocale } from '../i18n';
import type { Locale } from '../i18n';
import { translateCta, translateFacts, translatePerson } from '../i18n/helpers';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
---

<Layout title={t(locale, 'about.title')}>
  <HeroBanner
    title={t(locale, 'about.hero.title')}
    description={t(locale, 'about.hero.description')}
  />

  <AboutStory
    facts={translateFacts(aboutFacts, locale)}
    person={translatePerson(locale)}
    locale={locale}
  />
  <FinalCtaSection cta={translateCta(aboutFinalCta, locale)} />
</Layout>
