---
import HeroBanner from '../components/HeroBanner.astro';
import Layout from '../layouts/Layout.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactPartnership from '../components/sections/contact/ContactPartnership.astro';
import { partnershipForms, scenarios } from '../data/partnerships';
import { contactEmail, contactFaqs } from '../data/site';
import { t, defaultLocale } from '../i18n';
import { dt } from '../i18n/data-translations';
import type { Locale } from '../i18n';
import {
  translateFaqs,
  translatePartnershipForms,
  translateScenarios,
} from '../i18n/helpers';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
---

<Layout title={t(locale, 'contact.title')}>
  <HeroBanner
    id="partnership-contact"
    title={t(locale, 'contact.hero.title')}
    description={t(locale, 'contact.hero.description')}
    ctas={[
      {
        label: `${t(locale, 'contact.mailCta')} · ${contactEmail}`,
        href: `mailto:${contactEmail}`,
        variant: 'primary',
        icon: 'lucide:mail',
      },
    ]}
  />

  <ContactPartnership
    scenarios={translateScenarios(scenarios, locale)}
    forms={translatePartnershipForms(partnershipForms, locale)}
    locale={locale}
  />
  <FaqSection title={dt(locale, 'section.faqTitle')} faqs={translateFaqs(contactFaqs, locale)} />
</Layout>
