---
import Layout from '../layouts/Layout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import FinalCtaSection from '../components/sections/FinalCtaSection.astro';
import ChipChain from '../components/sections/chip/ChipChain.astro';
import ChipCriteria from '../components/sections/chip/ChipCriteria.astro';
import ChipLedger from '../components/sections/chip/ChipLedger.astro';
import ChipTabs from '../components/sections/chip/ChipTabs.astro';
import { pioneer } from '../data/ecosystem';
import { t, defaultLocale } from '../i18n';
import type { Locale } from '../i18n';
import { chipHref, isExternalHref, translateEcosystem } from '../i18n/chip-translations';
import { dt } from '../i18n/data-translations';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const data = translateEcosystem(pioneer, locale);
const link = (l: { label: string; href: string }) => ({
  label: l.label,
  href: chipHref(locale, l.href),
  external: isExternalHref(l.href),
});
const cta = {
  ...data.cta,
  primary: link(data.cta.primary),
  secondary: data.cta.secondary ? link(data.cta.secondary) : undefined,
};
---

<Layout title={t(locale, 'page.pioneer.title')} description={t(locale, 'page.pioneer.description')}>
  <ChipTabs active="pioneer" locale={locale} />

  <HeroBanner
    title={data.hero.title}
    description={data.hero.description}
    ctas={data.hero.ctas.map((c) => ({ ...link(c), variant: c.variant }))}
  />

  <section class="section bg-background">
    <div class="container-page" data-reveal>
      <SectionHeader title={data.what.title} subtitle={data.what.intro} />
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
        <div>
          <ChipCriteria
            title={data.what.coreTitle}
            items={data.what.core}
            note={data.what.coreNote}
          />
          {data.what.note && (
            <p class="mt-4 border-l-2 border-primary pl-4 text-sm leading-relaxed text-neutral-8">
              {data.what.note}
            </p>
          )}
        </div>
        <ChipLedger title={data.benefits.title} items={data.benefits.items} columns={2} />
      </div>
      <div class="mt-10">
        <ChipLedger title={data.revenue.title} items={data.revenue.lines} columns={3} numbered />
      </div>
    </div>
  </section>

  <section class="section bg-neutral-1 border-y border-neutral-3">
    <div class="container-page" data-reveal>
      <SectionHeader title={data.steps.title} />
      <ChipLedger items={data.steps.steps} columns={4} numbered />
      <div class="mt-8">
        <ChipChain
          title={data.certification.title}
          steps={data.certification.chain}
          note={data.certification.note}
        />
      </div>
    </div>
  </section>

  <FaqSection title={dt(locale, 'section.faqTitle')} faqs={data.faqs} />
  <FinalCtaSection cta={cta} />
</Layout>
