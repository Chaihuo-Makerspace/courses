---
import Layout from '../layouts/Layout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import ChipTabs from '../components/sections/chip/ChipTabs.astro';
import ChipWhatSection from '../components/sections/chip/ChipWhatSection.astro';
import ChipBenefitsSection from '../components/sections/chip/ChipBenefitsSection.astro';
import ChipRevenueSection from '../components/sections/chip/ChipRevenueSection.astro';
import ChipFlowSection from '../components/sections/chip/ChipFlowSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import FinalCtaSection from '../components/sections/FinalCtaSection.astro';
import { pioneer } from '../data/ecosystem';
import { t, defaultLocale } from '../i18n';
import type { Locale } from '../i18n';
import { chipHref, isExternalHref, translateEcosystem } from '../i18n/chip-translations';
import { dt } from '../i18n/data-translations';

const locale = (Astro.locals.locale ?? defaultLocale) as Locale;
const data = translateEcosystem(pioneer, locale);
const hero = data.hero;
const link = (l: { label: string; href: string }) => ({
  label: l.label,
  href: chipHref(locale, l.href),
  external: isExternalHref(l.href),
});
const cta = {
  ...data.cta,
  primary: link(data.cta.primary),
  secondary: data.cta.secondary ? link(data.cta.secondary) : undefined,
};
const certificationSteps = data.certification.chain.map((label, i) => ({ step: String(i + 1), title: label }));
---

<Layout title={t(locale, 'page.pioneer.title')} description={t(locale, 'page.pioneer.description')}>
  <ChipTabs active="pioneer" locale={locale} />

  <HeroBanner
    title={hero.title}
    description={hero.description}
    ctas={hero.ctas.map((cta) => ({
      label: cta.label,
      href: chipHref(locale, cta.href),
      variant: cta.variant,
      external: isExternalHref(cta.href),
    }))}
  >
    <Fragment slot="title">
      {hero.title}<span class="highlight">{hero.titleHighlight}</span>
    </Fragment>
  </HeroBanner>

  <ChipWhatSection section={data.what} />
  <ChipBenefitsSection section={data.benefits} />
  <ChipRevenueSection section={data.revenue} />
  <ChipFlowSection layout="vertical" section={data.steps} />
  <ChipFlowSection
    layout="chain"
    tone="yellow"
    section={{ title: data.certification.title, steps: certificationSteps, footnote: data.certification.note }}
  />
  <FaqSection title={dt(locale, 'section.faqTitle')} faqs={data.faqs} />
  <FinalCtaSection cta={cta} />
</Layout>